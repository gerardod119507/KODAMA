{
  "appId": "com.gerardo.kodama",
  "appName": "KODAMA",
  "webDir": "www",
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#071743",
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
